{
    "image": "mcr.microsoft.com/devcontainers/universal:2",
    "hostRequirements": {
      "cpus": 4
    },
    "waitFor": "onCreateCommand",
    "updateContentCommand": "pip install -r requirements.txt",
    "postCreateCommand": "",
    "postAttachCommand": "",
    "portsAttributes": {
      "5000": {
        "label": "Application",
        "onAutoForward": "openPreview"
      }
    },
    "customizations": {
      "codespaces": {
        "openFiles": [
          "server/app.py"
        ]
      },
      "vscode": {
        "extensions": [
            "ms-python.python",
            "GitHub.copilot",
            "GitHub.copilot-chat"
        ]
      }
    },
    "forwardPorts": [5000]
  }
